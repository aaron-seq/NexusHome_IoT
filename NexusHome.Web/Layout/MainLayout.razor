@using NexusHome.Web.Services
@inherits LayoutComponentBase
@inject LayoutStateService LayoutState

<div class="app-container @LayoutState.GetModeCssClass()">
    <aside class="sidebar">
        <div class="sidebar-logo">
            <span style="font-size: 1.75rem;">🏠</span>
            <h1>NexusHome</h1>
        </div>
        
        <NavMenu />
        
        <div style="margin-top: auto; padding-top: var(--spacing-lg); border-top: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 1rem;">
           
             <!-- Mode Toggles for Demo -->
            <div class="mode-selector">
                <button class="btn btn-sm @(LayoutState.CurrentMode == LayoutStateService.LayoutMode.Standard ? "btn-primary" : "btn-secondary")" 
                        @onclick="() => LayoutState.SetMode(LayoutStateService.LayoutMode.Standard)">Std</button>
                <button class="btn btn-sm @(LayoutState.CurrentMode == LayoutStateService.LayoutMode.Relax ? "btn-primary" : "btn-secondary")" 
                        @onclick="() => LayoutState.SetMode(LayoutStateService.LayoutMode.Relax)">Relax</button>
                <button class="btn btn-sm @(LayoutState.CurrentMode == LayoutStateService.LayoutMode.Emergency ? "btn-primary" : "btn-secondary")" 
                        @onclick="() => LayoutState.SetMode(LayoutStateService.LayoutMode.Emergency)">Err</button>
            </div>

            <button class="theme-toggle" @onclick="ToggleTheme">
                <span>@(isDarkMode ? "☀️" : "🌙")</span>
                <span>@(isDarkMode ? "Light Mode" : "Dark Mode")</span>
            </button>
        </div>
    </aside>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    private bool isDarkMode = true;

    protected override void OnInitialized()
    {
        // Default to dark mode
        isDarkMode = true;
        LayoutState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        LayoutState.OnChange -= StateHasChanged;
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        // Theme would be applied via JS interop in a full implementation
        await Task.CompletedTask;
    }
}
